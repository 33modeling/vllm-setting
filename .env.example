# Default target: 2x RTX 4090, one coding user, no image input.

MODEL=Qwen/Qwen3.6-27B-FP8
SERVED_MODEL_NAME=qwen3.6-27b
CUDA_VISIBLE_DEVICES=0,1
TP_SIZE=2
HOST=0.0.0.0
PORT=8000
PID_FILE=/home/kms/dev/vllm-setting/vllm.pid

# Stable default for 24 GB x 2.
# For larger repos, try 98304. For 128K, try KV_CACHE_DTYPE=fp8 and reduce if OOM.
MAX_MODEL_LEN=65536
KV_CACHE_DTYPE=auto
GPU_MEMORY_UTILIZATION=0.90

# Single-user setting: keep this at 1 unless serving multiple clients.
MAX_NUM_SEQS=1

# Larger values speed long prompt prefill but use more activation memory.
MAX_NUM_BATCHED_TOKENS=8192

# Coding-agent friendly defaults.
ENABLE_PREFIX_CACHING=1
ENABLE_CHUNKED_PREFILL=1
DISABLE_CUSTOM_ALL_REDUCE=1
ENABLE_TOOL_CALLS=0
TRUST_REMOTE_CODE=0

# stop-vllm.sh waits this long before SIGKILL.
TIMEOUT_SECONDS=30
