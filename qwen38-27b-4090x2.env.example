# Qwen3.8-27B FP8 on 2x RTX 4090 24GB.
# Copy to qwen38-27b-4090x2.env to override run-qwen38-27b-4090x2.sh defaults.
# This file is read INSTEAD of the shared .env, which pins the Qwen3.6 model.

MODEL=Qwen/Qwen3.8-27B-FP8
SERVED_MODEL_NAME=qwen3.8-27b-fp8
CUDA_VISIBLE_DEVICES=0,1
TP_SIZE=2
HOST=0.0.0.0
PORT=8000

# ~28 GB of FP8 weights over 2 cards leaves roughly 15 GB for KV.
# 131072 usually fits as well — only 16 of the 64 layers grow a KV cache.
# Go to 32768 first if you hit OOM at startup.
MAX_MODEL_LEN=65536
# bf16 KV fits at 65536 and keeps quality; switch to fp8 for 131072.
KV_CACHE_DTYPE=auto
GPU_MEMORY_UTILIZATION=0.90

# Single coding user. 2 leaves room for a background sub-agent request.
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=8192

ENABLE_PREFIX_CACHING=1
ENABLE_CHUNKED_PREFILL=1
# Consumer cards have no NVLink; custom all-reduce over PCIe can hang.
DISABLE_CUSTOM_ALL_REDUCE=1
ENABLE_TOOL_CALLS=1
TRUST_REMOTE_CODE=0

# 1 drops the vision tower to save VRAM. Set to 0 only if you need image input.
LANGUAGE_MODEL_ONLY=1

# PID_FILE defaults to <repo>/vllm-qwen38-4090x2.pid. Only set it here if you
# need a different location, and use an absolute path — this file is sourced
# after the script has already resolved its own directory.
#PID_FILE=/abs/path/vllm-qwen38-4090x2.pid

# The helper scripts source the shared .env, not this file, so pass the two
# values that differ on the command line:
#   PID_FILE=./vllm-qwen38-4090x2.pid PORT=8000 ./stop-vllm.sh
#   PORT=8000 SERVED_MODEL_NAME=qwen3.8-27b-fp8 ./health-check.sh
