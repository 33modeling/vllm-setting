# Long-context 2x RTX 4090 single-user coding profile.
# If this OOMs, use profiles/64k.env or reduce MAX_MODEL_LEN to 98304.

MODEL=Qwen/Qwen3.6-27B-FP8
SERVED_MODEL_NAME=qwen3.6-27b
CUDA_VISIBLE_DEVICES=0,1
TP_SIZE=2
HOST=0.0.0.0
PORT=8000

MAX_MODEL_LEN=131072
KV_CACHE_DTYPE=fp8
GPU_MEMORY_UTILIZATION=0.95
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=8192

ENABLE_PREFIX_CACHING=1
ENABLE_CHUNKED_PREFILL=1
DISABLE_CUSTOM_ALL_REDUCE=1
ENABLE_TOOL_CALLS=0
TRUST_REMOTE_CODE=0

TIMEOUT_SECONDS=45
WAIT_READY_SECONDS=420
REQUEST_TIMEOUT=180
CHAT_CHECK=1
