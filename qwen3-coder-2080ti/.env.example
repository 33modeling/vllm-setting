# Shared target: two RTX 2080 Ti 11 GB cards.
CUDA_VISIBLE_DEVICES=0,1
HOST=127.0.0.1
SERVED_MODEL_NAME=qwen3-coder-30b-a3b

# llama.cpp profile (recommended).
LLAMA_PORT=8080
LLAMA_CTX_SIZE=16384
LLAMA_TENSOR_SPLIT=1,1
LLAMA_CACHE_TYPE_K=q8_0
LLAMA_CACHE_TYPE_V=q8_0

# vLLM profile (best effort on 22 GB total VRAM).
VLLM_PORT=8000
VLLM_MODEL=cyankiwi/Qwen3-Coder-30B-A3B-Instruct-AWQ-4bit
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.92
VLLM_MAX_NUM_BATCHED_TOKENS=2048

# Health check.
BACKEND=llama
WAIT_READY_SECONDS=600
REQUEST_TIMEOUT=180
