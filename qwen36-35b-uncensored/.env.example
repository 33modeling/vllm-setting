# Target: two RTX 4090 24 GB cards — the same server as the root vLLM config.
# 루트의 vLLM 27B 서버와 VRAM을 공유하므로 동시에 못 띄운다 (../stop-vllm.sh 먼저).
CUDA_VISIBLE_DEVICES=0,1
HOST=127.0.0.1
SERVED_MODEL_NAME=qwen3.6-35b-uncensored

# llama.cpp server.
LLAMA_PORT=8080
LLAMA_CTX_SIZE=131072
LLAMA_TENSOR_SPLIT=1,1
LLAMA_CACHE_TYPE_K=f16
LLAMA_CACHE_TYPE_V=f16
LLAMA_PARALLEL=1

# Sampling defaults (Qwen 권장 thinking+coding 프로필).
# 일반 대화 위주면 LLAMA_TEMP=1.0 으로.
LLAMA_TEMP=0.6
LLAMA_TOP_P=0.95
LLAMA_TOP_K=20
LLAMA_MIN_P=0

# Download: HauhauCS 커스텀 K_P 양자화. Q6_K_P(~31 GB)가 2x24 GB 기본값.
GGUF_QUANT=Q6_K_P

# Vision (선택): mmproj 파일 경로를 지정하면 이미지 입력이 켜진다.
# DOWNLOAD_MMPROJ=1 ./download-gguf.sh 로 받은 뒤 주석 해제.
#LLAMA_MMPROJ=

# Health check.
WAIT_READY_SECONDS=600
REQUEST_TIMEOUT=180
