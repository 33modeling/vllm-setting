# Qwen3.8-27B BF16 on 2x H100 80GB.
# Copy to qwen38-27b-h100x2.env to override run-qwen38-27b-h100x2.sh defaults.
# This file is read INSTEAD of the shared .env, which pins the Qwen3.6 model.

MODEL=Qwen/Qwen3.8-27B
SERVED_MODEL_NAME=qwen3.8-27b
CUDA_VISIBLE_DEVICES=0,1
TP_SIZE=2
HOST=0.0.0.0
PORT=8000

# 160 GB of HBM covers the full native context. Beyond 262144 you need
# VLLM_ALLOW_LONG_MAX_MODEL_LEN=1 and YaRN scaling (up to 1M).
MAX_MODEL_LEN=262144
KV_CACHE_DTYPE=fp8
GPU_MEMORY_UTILIZATION=0.92

# Multi-user default. Drop to 2-4 if you want maximum single-session throughput.
MAX_NUM_SEQS=16
MAX_NUM_BATCHED_TOKENS=16384

ENABLE_PREFIX_CACHING=1
ENABLE_CHUNKED_PREFILL=1
# 0 keeps the custom all-reduce kernel, which is the fast path over NVLink.
DISABLE_CUSTOM_ALL_REDUCE=0
ENABLE_TOOL_CALLS=1
TRUST_REMOTE_CODE=0

# Qwen3.8-27B is natively multimodal; 0 keeps image/video input available.
LANGUAGE_MODEL_ONLY=0

# MTP draft head — helps latency at low concurrency, needs the speculative
# module in the checkpoint. Verify with a smoke test before leaving it on.
ENABLE_MTP=0
MTP_NUM_SPECULATIVE_TOKENS=3

# PID_FILE defaults to <repo>/vllm-qwen38-h100x2.pid. Only set it here if you
# need a different location, and use an absolute path — this file is sourced
# after the script has already resolved its own directory.
#PID_FILE=/abs/path/vllm-qwen38-h100x2.pid

# The helper scripts source the shared .env, not this file, so pass the two
# values that differ on the command line:
#   PID_FILE=./vllm-qwen38-h100x2.pid PORT=8000 ./stop-vllm.sh
#   PORT=8000 SERVED_MODEL_NAME=qwen3.8-27b ./health-check.sh
